{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/rsvp.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:familia/admision/:cupos",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/boda-jhon-keyla.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"boda-jhon-keyla.ics\""
        }
      ]
    }
  ]
}